{
  "id": "sglang_serving_and_offline:vdcores_offline_decode:batch1",
  "paper_baseline_run_id": "sglang_serving_and_offline",
  "paper_baseline_id": "sglang",
  "serving_workload_id": "vdcores_offline_decode",
  "model_tier": "primary",
  "model": "Qwen/Qwen3-8B",
  "batch_size": 1,
  "prompt_tokens": 128,
  "decode_tokens": 64,
  "traffic_mode": "offline fixed batch",
  "commands": [
    {
      "kind": "server",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.launch_server --model-path Qwen/Qwen3-8B --port 30000 --context-length 256 --disable-piecewise-cuda-graph"
    },
    {
      "kind": "online_serving",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_serving --backend sglang --model Qwen/Qwen3-8B --host 127.0.0.1 --port 30000 --dataset-name random-ids --tokenize-prompt --random-input-len 128 --random-output-len 64 --random-range-ratio 1.0 --num-prompts 1 --max-concurrency 1 --request-rate inf --output-file tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-serving-batch1.jsonl",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-serving-batch1.jsonl"
    },
    {
      "kind": "offline_throughput",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_offline_throughput --model-path Qwen/Qwen3-8B --context-length 384 --disable-piecewise-cuda-graph --dataset-name random --random-input-len 128 --random-output-len 64 --random-range-ratio 1.0 --num-prompts 1 --skip-warmup --result-filename tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-offline-batch1.json",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-offline-batch1.json"
    },
    {
      "kind": "one_batch",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_one_batch --model-path Qwen/Qwen3-8B --context-length 256 --disable-piecewise-cuda-graph --disable-cuda-graph --batch-size 1 --input-len 128 --output-len 64 --result-filename tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-one-batch1.json",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/vdcores_offline_decode/sglang-one-batch1.json"
    }
  ]
}

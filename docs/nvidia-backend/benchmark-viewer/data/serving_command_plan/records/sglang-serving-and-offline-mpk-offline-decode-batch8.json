{
  "id": "sglang_serving_and_offline:mpk_offline_decode:batch8",
  "paper_baseline_run_id": "sglang_serving_and_offline",
  "paper_baseline_id": "sglang",
  "serving_workload_id": "mpk_offline_decode",
  "model_tier": "primary",
  "model": "Qwen/Qwen3-8B",
  "batch_size": 8,
  "prompt_tokens": 64,
  "decode_tokens": 1024,
  "traffic_mode": "offline batched inference without request-arrival variability",
  "commands": [
    {
      "kind": "server",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.launch_server --model-path Qwen/Qwen3-8B --port 30000 --context-length 1088 --disable-piecewise-cuda-graph"
    },
    {
      "kind": "online_serving",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_serving --backend sglang --model Qwen/Qwen3-8B --host 127.0.0.1 --port 30000 --dataset-name random-ids --tokenize-prompt --random-input-len 64 --random-output-len 1024 --random-range-ratio 1.0 --num-prompts 8 --max-concurrency 8 --request-rate inf --output-file tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-serving-batch8.jsonl",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-serving-batch8.jsonl"
    },
    {
      "kind": "offline_throughput",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_offline_throughput --model-path Qwen/Qwen3-8B --context-length 1088 --disable-piecewise-cuda-graph --dataset-name random --random-input-len 64 --random-output-len 1024 --random-range-ratio 1.0 --num-prompts 8 --skip-warmup --result-filename tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-offline-batch8.json",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-offline-batch8.json"
    },
    {
      "kind": "one_batch",
      "command": "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_one_batch --model-path Qwen/Qwen3-8B --context-length 1088 --disable-piecewise-cuda-graph --disable-cuda-graph --batch-size 8 --input-len 64 --output-len 1024 --result-filename tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-one-batch8.json",
      "raw_artifact": "tmp/cuda-backend/paper-baselines/serving-runs/sglang/mpk_offline_decode/sglang-one-batch8.json"
    }
  ]
}

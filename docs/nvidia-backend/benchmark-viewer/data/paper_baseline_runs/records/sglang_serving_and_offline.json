  "paper_evaluation_id": "llm_serving_paper_baselines",
  "title": "SGLang Serving And Offline Throughput",
  "status": "imported_to_viewer",
  "hardware_targets": [
    "H200"
  ],
  "serving_workload_ids": [
    "mpk_offline_decode",
    "vdcores_offline_decode"
  ],
  "workload": {
    "model": "Qwen/Qwen3-8B primary, Qwen/Qwen3-1.7B bring-up",
    "input_policy": "mpk_offline_decode and vdcores_offline_decode prompt policies",
    "output_policy": "1024-token MPK-comparable decode and 64-token VDCores-comparable decode",
    "batch_or_concurrency": "offline batch sizes 1,2,4,8,16"
  },
  "setup_commands": [
    "cd tmp/baselines/sglang && python -m pip install -e \"python[all]\""
  ],
  "run_commands": [
    "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.launch_server --model-path <model> --port 30000",

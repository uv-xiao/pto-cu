    "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_offline_throughput --model-path <model>",
    "env PYTHONPATH=$PWD/tmp/baselines/sglang/python:$PYTHONPATH python -m sglang.bench_one_batch --model-path <model>"
  ],
